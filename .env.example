# Copy to .env.local and fill in. Never commit real values.
# Only DATABASE_URL and ADMIN_PASSWORD are required to run the site;
# everything else enables an optional feature.

# ── Database ──────────────────────────────────────────────────
# PostgreSQL connection string. Tables live in the "future_face" schema.
DATABASE_URL=postgresql://user:password@localhost:5432/portfolio
# TLS for the DB connection: require (default, encrypted), verify (encrypted + certificate
# checked against DATABASE_SSL_CA), disable (plain TCP, local Postgres without TLS only).
DATABASE_SSL=require
DATABASE_SSL_CA=

# ── Admin panel (/admin) ──────────────────────────────────────
# Login password (checked on the server) and the secret that signs the session cookie.
# Generate the secret with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# ── Public site address ───────────────────────────────────────
# Used in analytics exports. No trailing slash.
SITE_URL=https://example.com

# ── OpenAI (AI assistant: chat, realtime voice, transcription) ─
OPENAI_API_KEY=
# Optional SOCKS5 proxy for all AI calls, for servers where OpenAI is geo-blocked.
#   socks5h://user:password@proxy-host:1080
AI_PROXY_URL=

# AI spending guard: daily USD cap for the whole site and daily message quota per visitor.
AI_DAILY_BUDGET_USD=2
AI_DAILY_MESSAGES_PER_VISITOR=30

# ── Tavily (web search tool for the AI assistant) ─────────────
TAVILY_API_KEY=

# ── Google (analytics export to Sheets, auto-translation) ─────
# GOOGLE_SERVICE_ACCOUNT_B64 is the base64 of the service account JSON.
GOOGLE_SERVICE_ACCOUNT_B64=
GOOGLE_SHEET_ID=
GOOGLE_TRANSLATE_API_KEY=

# ── Secret for service endpoints ──────────────────────────────
# Bearer token for /api/analytics/export (hourly cron) and /api/revalidate.
CRON_SECRET=

# ── Media storage ─────────────────────────────────────────────
# Uploads are stored on local disk. Default: ./uploads
UPLOAD_DIR=
# ffmpeg/ffprobe binaries for video previews. Default: taken from PATH.
FFMPEG_PATH=
FFPROBE_PATH=
# Optional: where to redirect requests for media files missing locally
# (e.g. production origin while developing). No trailing slash.
MEDIA_FALLBACK_ORIGIN=

# ── Resume to PDF (headless Chrome) ───────────────────────────
# Path to Chrome/Chromium if it is not in a standard location.
CHROME_PATH=

# ── Private API for the owner's assistant (/api/sena/v1) ──────
# Without a key (or with a key shorter than 32 characters) the API answers 404.
# See lib/sena-api/README.md. Generate with:
#   node -e "console.log(require('crypto').randomBytes(36).toString('base64url'))"
SENA_SITE_KEY=
